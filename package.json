{
  "name": "night-neighbour",
  "version": "0.9.0-beta",
  "private": true,
  "type": "module",
  "description": "Night Neighbour - a first-person procedural neighbourhood horror simulation",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
